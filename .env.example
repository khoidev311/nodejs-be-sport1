# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# MongoDB Atlas connection string (Network Access must allow Vercel: 0.0.0.0/0)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional: token lifetimes (ms-style durations)
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=7d

# Optional: only used by `npm run seed` to create the first admin user
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Optional: only for `npm run crawl -- notify` when Expo push "enhanced security" is on
EXPO_ACCESS_TOKEN=
